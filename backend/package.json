{
  "name": "@mormors-kunafa/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build --workspace=@mormors-kunafa/shared && node scripts/sync-shared-dist.mjs src && node scripts/clean-dist.mjs && tsc && node scripts/sync-shared-dist.mjs dist",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "start": "node dist/index.js",
    "dev": "npm run build --workspace=@mormors-kunafa/shared && node scripts/sync-shared-dist.mjs src && tsx watch src/index.ts",
    "db:cleanup-order-item-snapshots": "tsx src/scripts/cleanup-order-item-product-name-snapshots.ts"
  },
  "dependencies": {
    "@mormors-kunafa/shared": "*",
    "@supabase/supabase-js": "^2.106.1",
    "@types/web-push": "^3.6.4",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "node-thermal-printer": "^4.6.0",
    "resend": "^6.12.2",
    "stripe": "^22.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/luxon": "^3.7.4",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2"
  }
}
