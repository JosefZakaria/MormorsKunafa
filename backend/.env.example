# Required for API (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for admin login and customer order-status tokens (at least 32 random bytes)
JWT_SECRET=
# Production admin cookies require the web app's same-origin /api proxy.

# Required in production for distributed abuse protection across Vercel instances
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server (local dev only; Vercel sets NODE_ENV=production)
PORT=3001

# Optional one-time WordPress admin migration. Keep real passwords out of files and Git.
# Example shape: {"admin@example.se":"a-unique-temporary-password"}
WP_MIGRATION_ADMIN_PASSWORDS_JSON=

# CORS — production frontend origin(s)
FRONTEND_URL=https://mormorskunafa.se
PUBLIC_WEB_APP_URL=https://mormorskunafa.se

# Stripe (card payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Order emails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SITE_PUBLIC_URL=https://mormorskunafa.se

# Optional: SMS (Sinch)
# Must match the region where the Sinch Conversation API app was created.
SINCH_REGION=eu
SINCH_PROJECT_ID=
SINCH_KEY_ID=
SINCH_KEY_SECRET=
SINCH_APP_ID=

# Optional: Web Push (PWA admin notifications)
WEB_PUSH_SUBJECT=mailto:admin@mormorskunafa.se
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Optional comma-separated exact provider hostnames in addition to the built-in browser push services.
WEB_PUSH_ALLOWED_HOSTS=

# Optional: admin stats / delete history
# Required in production; use separate random values of at least 32 bytes.
STATS_PASSWORD=
DELETE_PASSWORD=
# Required in production for authenticated Vercel Cron maintenance calls.
# Use a unique random value of at least 32 bytes.
CRON_SECRET=

# Optional: server-side receipt printer (local network only)
PRINTER_IP=192.168.1.100

# Optional: Swish (requires bank certificates on server filesystem).
# Use production only with a clean HTTPS callback URL and live bank credentials.
SWISH_ENV=test
SWISH_PAYEE_ALIAS=
SWISH_CERT_PATH=
SWISH_KEY_PATH=
SWISH_CALLBACK_BASE_URL=
